{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test test/phase1_security.test.js test/phase2_contracts.test.js test/phase3_security.test.js",
    "test:rules": "firebase --config ../firebase.json emulators:exec --only auth,firestore,storage \"node --test --test-concurrency=1 test/rules.test.js test/callables.test.js\"",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.1",
    "@google/genai": "^2.15.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0"
  },
  "private": true
}
